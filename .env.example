# Copia in .env (o incolla nelle variabili d'ambiente di Coolify).

# --- Obbligatorie ---
# Chiave di firma delle sessioni. Generala con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambiami-con-una-chiave-casuale

# Database. Con docker-compose viene composta in automatico dai valori POSTGRES_*.
# Con un Postgres esterno (Neon, Supabase, ...):
#   DATABASE_URL=postgresql://utente:password@host:5432/dbname
# Con SQLite, il file DEVE stare sul volume persistente /data, altrimenti
# i dati si perdono a ogni redeploy:
#   DATABASE_URL=sqlite:////data/app.db
DATABASE_URL=

# --- Solo per docker-compose ---
POSTGRES_USER=timesheet
POSTGRES_PASSWORD=cambiami
POSTGRES_DB=timesheet

# --- Facoltative ---
APP_NAME=RoxySheet
TZ=Europe/Rome
WEB_CONCURRENCY=2

# Aliquote del simulatore fiscale (default nel codice)
# TAX_COEFF_REDDITIVITA=0.67
# TAX_ALIQUOTA_INPS=0.2607
# TAX_ALIQUOTA_IMPOSTA=0.15

# Notifiche (non usate al momento dall'app)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=465
# MAIL_USERNAME=
# MAIL_PASSWORD=
